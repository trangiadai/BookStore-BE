<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tgd.dao.mappers.ProductImageMapper">

	<resultMap id="ProductImageResultMap" type="com.tgd.entity.ProductImage">
		<id property="id" column="product_image_id" />
		<result property="url" column="product_image_url" />
		<result property="publicId" column="product_image_public_id" />
		<result property="productId" column="product_image_product_id" />
	</resultMap>

	<sql id="ProductImageColumns">
		pi.id AS product_image_id,
		pi.url AS product_image_url,
		pi.public_id AS product_image_public_id,
		pi.product_id AS product_image_product_id
	</sql>

	<sql id="productImageFullSelect"> 
		SELECT 
			<include refid="ProductImageColumns" />
		FROM product_images pi
	</sql>
	
	<select id="getProductImageById" resultMap="ProductImageResultMap">
		<include refid="productImageFullSelect" />
		WHERE pi.id = #{productImageId}
	</select>

	<select id="getAllProductImages" resultMap="ProductImageResultMap">
		<include refid="productImageFullSelect" />
		ORDER BY p.id DESC
	</select>
	
	<insert id="createProductImage" parameterType="map" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO product_images (url, public_id, product_id)
		VALUES (
			#{url},
			#{publicId},
			#{productId}
		)
	</insert>
	
	<delete id="deleteProductImage">
		DELETE FROM product_images WHERE id = #{productImageId}
	</delete>

</mapper>